# Copy this to .env and fill in what you have.
# On Railway, add the same names as Service Variables.

# --- AI providers (chatbot uses whichever are set, Groq first) ---
GROQ_API_KEY=            # console.groq.com - free, fast Llama 3.3 70B
GEMINI_API_KEY=          # aistudio.google.com - free tier
HUGGINGFACE_API_KEY=     # huggingface.co/settings/tokens - free tier fallback

# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Weather & news ---
OPENWEATHER_API_KEY=
GNEWS_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
